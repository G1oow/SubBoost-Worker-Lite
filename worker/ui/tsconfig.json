{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@subboost/core": ["../../packages/core/src/index.ts"],
      "@subboost/core/*": ["../../packages/core/src/*"],
      "@subboost/server-core/*": ["../../packages/server-core/src/*"],
      "@subboost/ui/*": ["../../packages/ui/src/*"]
    }
  },
  // ../src/env.d.ts 提供 Env / KVNamespace 等最小 Worker 全局声明：
  // 演示模式（src/demo）复用 worker/src 的真实路由，需要这些类型。
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../src/env.d.ts"]
}
